% IEEE copy of docs/references.bib, generated by scripts/paper_to_ieee.py for
% IEEEtran.bst. Software and dataset entries become misc; the version, the
% access date, the DOI and, without a DOI, the arXiv identifier move into
% the note; a misc entry's publisher becomes howpublished or organization
% unless it repeats the author. Acronyms and inner capitals in titles and a
% note's first word are braced; other title words follow IEEE's sentence
% case. Accented letters are written as LaTeX accents. The control entry
% makes IEEEtran.bst list the first author and et al. beyond six authors.

@IEEEtranBSTCTL{IEEEexample:BSTcontrol,
  CTLuse_forced_etal       = "yes",
  CTLmax_names_forced_etal = "6",
  CTLnames_show_etal       = "1",
  CTLdash_repeated_names   = "no",
}

